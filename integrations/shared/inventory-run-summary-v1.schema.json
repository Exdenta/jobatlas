          "type": "integer"
        },
        "duplicateSuppressed": {
          "type": "integer"
        },
        "emitted": {
          "type": "integer"
        },
        "scanLimited": {
          "type": "boolean"
        },
        "chargeLimited": {
          "type": "boolean"
        },
        "errorClass": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "cleanupErrorClass": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    {
