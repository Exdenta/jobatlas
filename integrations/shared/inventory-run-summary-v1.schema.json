{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Exdenta/jobatlas/main/integrations/shared/inventory-run-summary-v1.schema.json",
  "title": "Inventory job Actor run summary",
  "description": "Derived from the canonical simple and normalized runtime summary dataclasses, runtime 0.3.2. Dataset diagnostics remain outside job rows.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "source",
        "tier",
        "status",
        "inventoryRequests",
        "inventoryScanned",
        "inventoryAsOf",
        "sourceFreshAt",
        "provenCandidates",
        "duplicateSuppressed",
        "emitted",
        "scanLimited",
        "chargeLimited",
        "errorClass",
        "cleanupErrorClass"
      ],
