            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenCandidates": {
          "type": "integer"
        },
        "duplicateSuppressed": {
          "type": "integer"
        },
        "sourceFiltered": {
          "type": "integer"
        },
        "enrichmentFailed": {
          "type": "integer"
        },
        "finalFiltered": {
          "type": "integer"
        },
        "emitted": {
          "type": "integer"
        },
        "scanLimited": {
          "type": "boolean"
        },
        "chargeLimited": {
          "type": "boolean"
        },
        "errorClass": {
