        "sourceFreshAt",
        "provenCandidates",
        "duplicateSuppressed",
        "sourceFiltered",
        "enrichmentFailed",
        "finalFiltered",
        "emitted",
        "scanLimited",
        "chargeLimited",
        "errorClass",
        "cleanupErrorClass"
      ],
      "properties": {
        "schemaVersion": {
          "const": "nomad-inventory-public-run-v1"
        },
        "source": {
          "type": "string"
        },
        "tier": {
          "enum": [
            "normalized"
          ]
        },
        "status": {
          "enum": [
            "running",
            "succeeded",
            "partial",
            "failed"
          ]
        },
        "inventoryRequests": {
          "type": "integer"
        },
        "inventoryScanned": {
          "type": "integer"
        },
